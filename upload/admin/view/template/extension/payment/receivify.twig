{#
  Receivify for OpenCart — admin settings form (OpenCart 3.x / Twig).
#}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-receivify" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-receivify" class="form-horizontal">

          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-status" data-toggle="tab">{{ tab_status }}</a></li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">

              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-api-url">{{ entry_api_url }}</label>
                <div class="col-sm-10">
                  <input type="text" name="payment_receivify_api_url" value="{{ payment_receivify_api_url }}" placeholder="https://receivify.io" id="input-api-url" class="form-control"/>
                  {% if error_api_url %}<div class="text-danger">{{ error_api_url }}</div>{% endif %}
                  <div class="help-block">{{ help_api_url }}</div>
                </div>
              </div>

              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
                <div class="col-sm-10">
                  <input type="password" name="payment_receivify_api_key" value="{{ payment_receivify_api_key }}" placeholder="rcv_live_…" id="input-api-key" class="form-control" autocomplete="new-password"/>
                  {% if error_api_key %}<div class="text-danger">{{ error_api_key }}</div>{% endif %}
                  <div class="help-block">{{ help_api_key }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-webhook-secret">{{ entry_webhook_secret }}</label>
                <div class="col-sm-10">
                  <input type="password" name="payment_receivify_webhook_secret" value="{{ payment_receivify_webhook_secret }}" placeholder="whsec_…" id="input-webhook-secret" class="form-control" autocomplete="new-password"/>
                  <div class="help-block">{{ help_webhook_secret }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-webhook-secret-previous">{{ entry_webhook_secret_previous }}</label>
                <div class="col-sm-10">
                  <input type="password" name="payment_receivify_webhook_secret_previous" value="{{ payment_receivify_webhook_secret_previous }}" id="input-webhook-secret-previous" class="form-control" autocomplete="new-password"/>
                  <div class="help-block">{{ help_webhook_secret_previous }}</div>
                  <div class="alert alert-info" style="margin-top:10px">{{ text_rotation_help }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_callback_url }}</label>
                <div class="col-sm-10">
                  <input type="text" value="{{ callback_url }}" class="form-control" readonly onclick="this.select();"/>
                  <div class="help-block">{{ text_webhook_help }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-asset">{{ entry_asset }}</label>
                <div class="col-sm-10">
                  <select name="payment_receivify_asset" id="input-asset" class="form-control">
                    {% for asset in assets %}
                      <option value="{{ asset.code }}"{% if asset.code == payment_receivify_asset %} selected{% endif %}>{{ asset.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="help-block">{{ help_asset }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-total">{{ entry_total }}</label>
                <div class="col-sm-10">
                  <input type="text" name="payment_receivify_total" value="{{ payment_receivify_total }}" id="input-total" class="form-control"/>
                  <div class="help-block">{{ help_total }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
                <div class="col-sm-10">
                  <select name="payment_receivify_geo_zone_id" id="input-geo-zone" class="form-control">
                    <option value="0">{{ text_all_zones }}</option>
                    {% for geo_zone in geo_zones %}
                      <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_receivify_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="payment_receivify_status" id="input-status" class="form-control">
                    <option value="1"{% if payment_receivify_status %} selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not payment_receivify_status %} selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="payment_receivify_sort_order" value="{{ payment_receivify_sort_order }}" id="input-sort-order" class="form-control"/>
                </div>
              </div>
            </div>

            <div class="tab-pane" id="tab-status">
              {% set status_fields = [
                { 'name': 'payment_receivify_pending_status_id',    'label': entry_pending_status,    'value': payment_receivify_pending_status_id },
                { 'name': 'payment_receivify_confirming_status_id', 'label': entry_confirming_status, 'value': payment_receivify_confirming_status_id },
                { 'name': 'payment_receivify_order_status_id',      'label': entry_order_status,      'value': payment_receivify_order_status_id },
                { 'name': 'payment_receivify_expired_status_id',    'label': entry_expired_status,    'value': payment_receivify_expired_status_id },
                { 'name': 'payment_receivify_failed_status_id',     'label': entry_failed_status,     'value': payment_receivify_failed_status_id }
              ] %}
              {% for field in status_fields %}
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-{{ field.name }}">{{ field.label }}</label>
                  <div class="col-sm-10">
                    <select name="{{ field.name }}" id="input-{{ field.name }}" class="form-control">
                      {% for order_status in order_statuses %}
                        <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == field.value %} selected{% endif %}>{{ order_status.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
